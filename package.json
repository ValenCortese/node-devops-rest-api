{
  "name": "pokeapi-rest-api",
  "version": "1.0.0",
  "description": "API REST simple para consultar Pokémon usando Node.js, Express y PokéAPI.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest"
  },
  "keywords": [
    "nodejs",
    "express",
    "pokeapi",
    "rest",
    "api"
