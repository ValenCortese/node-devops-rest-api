# Grafana Cloud — OpenTelemetry
# Conseguís estos valores en: grafana.com → tu stack → OpenTelemetry
# En Grafana Cloud no usamos collector local: el SDK envia directo al OTLP Gateway.

OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64-encoded-credentials>
OTEL_SERVICE_NAME=pokemon-api

# App
PORT=3000
NODE_ENV=production
LOG_LEVEL=info